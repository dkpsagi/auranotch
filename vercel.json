{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/success", "destination": "/success/index.html" }
  ],
  "headers": [
    {
      "source": "/AuraNotch.dmg",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"AuraNotch.dmg\""
        }
      ]
    }
  ]
}
